# Copia este archivo como ".env" (instalar.bat lo hace solo) y cambia lo que quieras.
# El archivo .env NO se sube a GitHub.

# PIN para que nadie mas en tu Wi-Fi pueda usar tu asistente (recomendado)
ASISTENTE_PIN=

# Como quieres que te llame (vacio = te trata de tu)
ASISTENTE_LLAMARME=Sergio

# Dejalo vacio para que ELLA escoja su nombre. Si quieres forzar uno, escribelo (ej: LEK)
ASISTENTE_NOMBRE=

# Ciudad para el clima y lo local
ASISTENTE_CIUDAD=Palmira, Valle del Cauca

# Cerebro en la nube (Claude). Mejor ponla desde Ajustes en la pantalla de Luna.
# CLAUDE_API_KEY=

# Cerebro local (Ollama), queda de respaldo si hay clave de Claude. qwen3:8b necesita ~8 GB de RAM; si tu PC es mas justo usa qwen3:4b
ASISTENTE_MODELO=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434

ASISTENTE_PUERTO=8443
# Puerto para este mismo PC (sin aviso de certificado)
ASISTENTE_PUERTO_PC=8090
# Abrir la ventana de Luna escuchando apenas arranca (si / no)
ASISTENTE_ABRIR_VENTANA=si

# Oido del collar: tiny / base / small / medium (mas grande = entiende mejor pero mas lento)
WHISPER_MODELO=small

# --- Fase 2 ---
# "Luna" en segundo plano sin abrir nada: auto = se enciende si corriste instalar_voz.bat; no = apagado
ASISTENTE_DESPERTADOR=auto
# Automejora: por defecto TODA habilidad nueva espera tu aprobacion (LEK 2.0).
# Con "si", Luna activaria sola la de bajo riesgo que pase sus pruebas (siempre avisando con el codigo).
LUNA_AUTOMEJORA_AUTONOMA=no
# Certificado propio (p. ej. el de "tailscale cert"), para que el iPhone y Atajos confien sin avisos
# ASISTENTE_CERT=
# ASISTENTE_KEY=
